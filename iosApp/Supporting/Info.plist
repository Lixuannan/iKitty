<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>zh_CN</string>
	<key>CFBundleDisplayName</key>
	<string>iKitty</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>6</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!--
	  相册不需要权限：用的是 PHPickerViewController（SwiftUI 的 PhotosPicker），
	  它在应用外运行、只回传用户选中的那几张，所以不需要 NSPhotoLibraryUsageDescription。
	  相机必须声明用途，否则调用 UIImagePickerController 会直接崩溃。
	-->
	<key>NSCameraUsageDescription</key>
	<string>用来拍照发给猫猫。照片只保存在本机，并直接发给你配置的模型服务。</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!--
		  与 Android 的 network_security_config.xml 对齐：那边全局放开明文流量，
		  因为本地与局域网的大模型服务（Ollama、LM Studio、vLLM…）通常只提供 http。
		  如果这里只放行 ip-api.com，用户在 iOS 上填 http://192.168.x.x:11434/v1
		  会统一失败在 ATS 上——而同一个地址在 Android 上是能用的，属于真实的功能不对齐。

		  注意：NSAllowsArbitraryLoads 与 NSAllowsLocalNetworking 同时出现时，
		  iOS 10+ 会**忽略**前者。所以这里只用 NSAllowsArbitraryLoads，不要加 NSAllowsLocalNetworking。

		  代价要说清楚：这等于关掉了 ATS。要上架 App Store 时，审核可能要求说明理由；
		  如果只支持少数固定服务商，更稳的做法是改用 NSExceptionDomains 逐个列出，
		  并去掉这个键。
		-->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
